# ==========================================
# FRONTEND — SeuFluxo WhatsApp (Vite React)
# ==========================================

# URL base da API (produção: subdomínio próprio da API)
VITE_API_BASE_URL=https://apiseufluxowhatsapp.transformafuturo.com.br

# Supabase (client-side — usa a ANON KEY, não a service_role)
VITE_SUPABASE_URL=https://pamhgjhijftcnfbhjoyk.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica_aqui

# ==========================================
# BACKEND — SeuFluxo API (FastAPI Python)
# ==========================================

# Supabase (Server-side - bypass RLS)
SUPABASE_URL=https://pamhgjhijftcnfbhjoyk.supabase.co
SUPABASE_KEY=sua_chave_service_role_secreta_aqui

# Evolution API
EVOLUTION_API_URL=https://evo.transformafuturo.com.br
EVOLUTION_API_GLOBAL_KEY=sua_global_key_secreta_aqui

# MinIO (Armazenamento de mídia)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sistema_atendimento
MINIO_SECRET_KEY=sua_secret_key_do_minio_aqui
MINIO_BUCKET=whatsapp-storage
MINIO_SECURE=FALSE
MINIO_REGION=us-east-1

# ==========================================
# AI AGENT — LLM (escolha um provedor)
# ==========================================

# Provedor ativo: "groq" (rápido/gratuito) | "openai" (GPT) | "deepseek"
AI_PROVIDER=groq

# Groq — gratuito em: https://console.groq.com
GROQ_API_KEY=gsk_sua_chave_aqui

# OpenAI — pago em: https://platform.openai.com
OPENAI_API_KEY=sk-sua_chave_aqui

# DeepSeek — barato em: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-sua_chave_deepseek_aqui

# Modelo customizado (deixe vazio para usar o padrão do provedor)
# Groq padrão:    llama-3.3-70b-versatile
# OpenAI padrão:  gpt-4o-mini
# DeepSeek padrão: deepseek-chat
AI_MODEL=
